# REQUIRED — app will not boot without these
DATABASE_URL=postgresql://launchpad:launchpad@localhost:5432/launchpad
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# OPTIONAL — runtime mode (defaults to development)
# NODE_ENV=development

# OPTIONAL — enables Stripe billing
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
# STRIPE_PRICE_ID=price_replace_me
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# OPTIONAL — enables transactional email via Resend
# EMAIL_FROM=onboarding@resend.dev
# RESEND_API_KEY=

# OPTIONAL — enables Google sign-in
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NEXT_PUBLIC_GOOGLE_ENABLED=true

# OPTIONAL — enables x402 agent payments (EVM and/or Solana)
# RESOURCE_WALLET_ADDRESS=
# NETWORK=base-sepolia
# SOLANA_RESOURCE_WALLET_ADDRESS=
# SOLANA_NETWORK=solana-devnet
# FACILITATOR_URL=https://x402.org/facilitator
